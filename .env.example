# ==========================================
# LLM & Embeddings
# ==========================================

GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

LLM_MODEL_ANSWER=llama-3.3-70b-versatile
LLM_MODEL_GRADER=llama-3.1-8b-instant
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5


# ==========================================
# Vector Database - Qdrant
# ==========================================

QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=documents


# ==========================================
# PostgreSQL
# ==========================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres


# ==========================================
# Cache - Upstash Redis
# ==========================================

UPSTASH_REDIS_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# 7 days
CACHE_TTL_EMBEDDINGS=604800

# 1 hour
CACHE_TTL_RAG=3600

# 24 hours
CACHE_TTL_SQL_GEN=86400

# 15 minutes
CACHE_TTL_SQL_RESULT=900

# 24 hours
CACHE_TTL_INTENT=86400


# ==========================================
# Document Deduplication / Storage
# ==========================================

# Options: local, s3
STORAGE_BACKEND=local

S3_CACHE_BUCKET=your-s3-cache-bucket
AWS_REGION=us-east-1


# ==========================================
# Web Search - Tavily
# ==========================================

TAVILY_API_KEY=your_tavily_api_key_here


# ==========================================
# Authentication
# ==========================================

# Replace with a strong random secret
JWT_SECRET=replace_with_a_secure_random_secret

JWT_EXPIRATION_MINUTES=60


# ==========================================
# Rate Limiting & Token Budget
# ==========================================

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

MAX_TOKENS_PER_USER_DAILY=100000

AUTH_LOGIN_RATE_LIMIT_PER_MIN=5
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=3


# ==========================================
# Input Restructuring
# ==========================================

MAX_INPUT_TOKENS=3000
RESERVED_CONTEXT_TOKENS=1000
RESERVED_OUTPUT_TOKENS=1000


# ==========================================
# Security Thresholds
# ==========================================

PROMPT_INJECTION_THRESHOLD=0.75
TOXICITY_THRESHOLD=0.75
OUTPUT_TOXICITY_THRESHOLD=0.5

MAX_VALIDATION_RETRIES=2


# ==========================================
# Retrieval Defaults
# ==========================================

# HyDE
HYDE_NUM_HYPOTHESES=3
HYDE_ENABLED_BY_DEFAULT=false

# Hybrid retrieval
HYBRID_SEARCH_ENABLED=true

# Reciprocal Rank Fusion
RRF_K=60

# Reranking
# Options: local, voyage
RERANKER_BACKEND=local

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=rerank-2.5

RERANKER_INITIAL_TOP_K=20
RERANKING_ENABLED_BY_DEFAULT=true


# ==========================================
# Corrective RAG (CRAG)
# ==========================================

CRAG_RELEVANCE_THRESHOLD=0.7
CRAG_AMBIGUOUS_THRESHOLD=0.5
CRAG_ENABLED_BY_DEFAULT=true


# ==========================================
# Self-Reflection
# ==========================================

REFLECTION_MIN_SCORE=0.85
MAX_REFLECTION_RETRIES=2
SELF_REFLECTIVE_ENABLED_BY_DEFAULT=false


# ==========================================
# Vanna / Text-to-SQL
# ==========================================

VANNA_MODEL=llama-3.1-8b-instant
VANNA_TEMPERATURE=0.0
VANNA_SEED=42


# ==========================================
# Logging
# ==========================================

# Set to true in production
LOG_JSON=false

LOG_LEVEL=INFO